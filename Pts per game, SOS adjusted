  A10<-0
  B25<-0
  B10<-0
  for (l in unlist(Awins$Loser)){
    LoserRankA <- Power_rankings[Power_rankings$School == l,][1,"APCurr"]
    if (!is.na(LoserRankA)) {
      if (LoserRankA>10){
        A25<-A25+1
      } else if (LoserRankA> 0){
        A10<-A10+1
      }
    }
  }
  for (i in unlist(Bwins$Loser)){
    LoserRankB<- Power_rankings[Power_rankings$School == i,][1,"APCurr"]
    if (!is.na(LoserRankB)) {
      if (LoserRankB>10){
        B25<-B25+1
      } else if (LoserRankB > 0){        
        B10<-B10+1
      }
    }
  }
  Abase<- (teamA$PwrRk)
  Bbase<- (teamB$PwrRk)
  Arate<- Abase+5*A25+10*A10
  Brate<- Bbase+5*B25+10*B10
  prediction<- Arate-Brate
  return(prediction)
}
```
Example usage

```
