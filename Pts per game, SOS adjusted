Create Prediction method
```
Predict_Game<- function(SchoolA, SchoolB){
  if (!(SchoolA %in% Power_rankings$School)){     #if the team is not in the database, then it is a lower division school, and we automatically set a FBS team to beat a non-FBS team
    return(-1)
  }
  if (!(SchoolB %in% Power_rankings$School)){
    return(1)
  } 
  teamA<- Power_rankings[Power_rankings$School == SchoolA,][1,]    #create databases for just the stats of the 2 teams 
  teamB<- Power_rankings[Power_rankings$School == SchoolB,][1,]

  Awins<- full_schedule[full_schedule$Winner == SchoolA,]
  Bwins<- full_schedule[full_schedule$Winner == SchoolB,]
  A25<-0    # number of team A's top 25 wins
  A10<-0    # number of team A's top 10 wins
  B25<-0    # number of team B's top 25 wins
  B10<-0    # number of team B's top 10 wins
  for (l in unlist(Awins$Loser)){
    LoserRankA <- Power_rankings[Power_rankings$School == l,][1,"APCurr"]    #count number of top 10 and 25 wins for both teams
    if (!is.na(LoserRankA)) {
      if (LoserRankA>10){
        A25<-A25+1
      } else if (LoserRankA> 0){
        A10<-A10+1
      }
    }
  }
  for (i in unlist(Bwins$Loser)){
    LoserRankB<- Power_rankings[Power_rankings$School == i,][1,"APCurr"]
    if (!is.na(LoserRankB)) {
      if (LoserRankB>10){
        B25<-B25+1
      } else if (LoserRankB > 0){        
        B10<-B10+1
      }
    }
  }
  Abase<- (teamA$PwrRk)
  Bbase<- (teamB$PwrRk)
  Arate<- Abase+5*A25+10*A10  #calculate ratings for A and B, for how many points they are expected to score, weighted by their amount of top 10 and top 25 wins
  Brate<- Bbase+5*B25+10*B10
  prediction<- Arate-Brate
  return(prediction)
}
```
Example usage

```
Predict_Game(Auburn, Georgia) #output : -12.16, means Auburn is favored to lose to Georgia by 12.16 points.
```
